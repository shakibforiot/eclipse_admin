# ECLPISE DUMP Environment Configuration Example

# Server Port
PORT=3000

# JWT & Security Secrets
JWT_SECRET=eclipsedump_secure_jwt_secret_key_2026_prod
ADMIN_SESSION_EXPIRY=7d

# Default Initial Admin Account (Created on first run if database has 0 admins)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin!
ADMIN_DEFAULT_EMAIL=admin@eclipsedump.app

# Server Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=60

# PostgreSQL Connection (Optional for Production cloud deployments)
# PGHOST=dpg-da3qvqijobas739hrklg-a.singapore-postgres.render.com
# PGPORT=5432
# PGUSER=eclipse_admin
# PGPASSWORD=your_postgres_password
# PGDATABASE=eclipse_dump_db
# PGSSL=true

# Application Base URL
APP_URL=http://localhost:3000
